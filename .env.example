# Copy to .env and fill in. .env is gitignored — never commit real paths or keys.

# Root directory holding all downloaded datasets.
# Expected layout:
#   $MIRN_DATA_ROOT/peroi/        (Zenodo 18876411, CC-BY-4.0)
#   $MIRN_DATA_ROOT/thor_magni/   (Zenodo 10407223, CC-BY-4.0)
#   $MIRN_DATA_ROOT/jrdb/         (registration required, CC BY-NC-SA 3.0)
MIRN_DATA_ROOT=/absolute/path/to/datasets

# Where experiment CSVs are written. Defaults to ./results if unset.
MIRN_RESULTS_DIR=./results

# Global default seed. Every stochastic path still takes an explicit seed;
# this is only the fallback for interactive exploration.
MIRN_SEED=0

# Torch device: cpu | cuda | mps
MIRN_DEVICE=cpu
