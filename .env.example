# Copy to .env, which is gitignored.
#
# There is very little here on purpose. MIRN used to read dataset roots and a torch device; the
# dataset adapter and the model are both gone, and an example file that declares variables nothing
# reads is a map of a building that has been demolished.

# Where `mirn run <experiment>` writes its CSVs. Defaults to ./results.
MIRN_RESULTS_DIR=./results

# The default seed for the CLI. Every experiment is deterministic given one, and every CSV records
# the seed it was run with, so this only sets the starting point.
MIRN_SEED=0
