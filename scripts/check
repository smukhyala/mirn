#!/usr/bin/env bash
# Everything, in fast-fail-first order.
#
# The JavaScript chain runs in seconds; pytest takes about six minutes, dominated by the
# split-half nulls and the Sinkhorn solver. Putting the cheap checks first means a typo fails in
# five seconds rather than after the slow suite has finished being right about everything else.
set -euo pipefail

PY=".venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "error: $PY not found. Bare 'python' is not on PATH in this project; create the venv first." >&2
  exit 1
fi

echo "==> ruff"
"$PY" -m ruff check src tests

echo "==> typecheck"
npm run typecheck

# Notes before vitest: the render suite boots the real widget code against the compiled pages, so
# web/generated has to exist. The other order works on any machine that has built once before,
# which is why it survived here and failed on CI's first clean checkout.
echo "==> notes (lints, vocabulary ladder, quantity references)"
npm run notes

echo "==> vitest"
npx vitest run

echo "==> vite build"
npx vite build

echo "==> pytest"
"$PY" -m pytest -q

# Covered by tests/test_fixtures.py, which compares the mathematics and ignores the environment
# stamp a fixture records. A whole-file diff fails on any machine whose numpy differs from the one
# that last regenerated, which is a false alarm dressed as a stale fixture.

echo
echo "all checks passed"
